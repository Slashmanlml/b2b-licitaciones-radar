# Credenciales del bot de Telegram que despacha las alertas.
# Se obtienen creando un bot con @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Fuente de datos: "fixture" (ejemplo, por defecto), "datosgobar" (dataset real
# de datos.gob.ar) o "comprar" (sin implementar, falla explícito).
PROVIDER=fixture

# Días de anticipación para la alerta de vencimiento de pliegos (default 3).
# EXPIRY_DAYS=3

# Suscriptores con filtro de rubros (JSON). Lista vacía o "*" = recibe todo.
# Sin esta variable se usa TELEGRAM_CHAT_ID como destino único (recibe todo).
# SUBSCRIBERS_JSON='[{"chatId":"123","categorias":["TECNOLOGIA","SALUD"]}]'

# Solo para PROVIDER=datosgobar (valores por defecto si se omiten):
# DATOSGOBAR_CSV_URL=     # override del CSV de Convocatorias
# DATOSGOBAR_TAIL_BYTES=3000000  # cuánta cola del CSV descargar (~1 año)
# DATOSGOBAR_WINDOW_DAYS=120     # ventana de publicación (el dataset va por tandas)
# DATOSGOBAR_MAX_ROWS=25         # tope de alertas por corrida (lo nuevo primero)
